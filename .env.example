# ---------- Obligatorias ----------

# Postgres. En Vercel, la integración de Neon la carga sola.
DATABASE_URL="postgresql://usuario:clave@host/base?sslmode=require"

# Firma de las sesiones. Generar con: openssl rand -base64 48
AUTH_SECRET=""

# Protege la tarea diaria. Vercel la manda sola como "Authorization: Bearer ...".
# Generar con: openssl rand -hex 32
CRON_SECRET=""

# Usuario principal. Mientras las dos estén definidas, cada deploy lo deja con este email y esta contraseña.
# Después del primer ingreso: cambiar la contraseña desde Ajustes y borrar ADMIN_PASSWORD de Vercel.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NOMBRE="Julián"

# ---------- Opcionales ----------

# Dirección pública de la app, para los enlaces de los correos. Ej.: https://julian-os.vercel.app
APP_URL=""

# Correos (recuperar contraseña, resumen diario y semanal). Sin esto, la app funciona igual pero no manda correos.
RESEND_API_KEY=""
EMAIL_FROM="Julián OS <avisos@tudominio.com>"

# Asistente con IA y lectura de facturas por foto. Sin esto, el asistente usa su intérprete propio
# (entiende los pedidos más comunes) y el botón de leer facturas no aparece.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-5-5"
